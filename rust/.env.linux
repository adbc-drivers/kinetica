# Where the validation suite finds the Kinetica that compose.yaml starts, read
# by the CI on Linux before the tests. The password is that throwaway
# instance's, as compose.yaml sets it; a value already in the environment wins.
export KI_URL="${KI_URL:-http://127.0.0.1:9191}"
export KI_USER="${KI_USER:-admin}"
export KI_PWD="${KI_PWD:-kinetica-ci}"
# The validation suite runs as this ordinary user, which it creates as KI_USER
export KI_VALIDATION_USER="${KI_VALIDATION_USER:-adbc_validation}"
export KI_VALIDATION_PWD="${KI_VALIDATION_PWD:-kinetica-ci-validation}"
