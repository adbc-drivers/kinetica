// part: metadata

[tags]
field-type-name = "DATETIME"
sql-type-name = "DATETIME"
caveats = ["Kinetica's dates run from 1000-01-01 to 2900-12-31"]

// part: setup_query

CREATE TABLE test_timestamp (
    idx INTEGER,
    res DATETIME
);

INSERT INTO test_timestamp (idx, res) VALUES (1, TIMESTAMP '2023-05-15 13:45:30');
INSERT INTO test_timestamp (idx, res) VALUES (2, TIMESTAMP '2000-01-01 00:00:00');
INSERT INTO test_timestamp (idx, res) VALUES (3, TIMESTAMP '1969-07-20 20:17:40');
INSERT INTO test_timestamp (idx, res) VALUES (4, TIMESTAMP '1000-01-01 00:00:00');
INSERT INTO test_timestamp (idx, res) VALUES (5, TIMESTAMP '2900-12-31 23:59:59');
INSERT INTO test_timestamp (idx, res) VALUES (6, NULL);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsm:",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"res": 1684158330000}
{"res": 946684800000}
{"res": -14182940000}
{"res": -30610224000000}
{"res": 29379542399000}
{"res": null}
